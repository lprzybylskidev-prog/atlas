{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "name": "atlas",
    "packageManager": "pnpm@11.18.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check:secrets": "bash tools/quality/check-secrets.sh",
        "check:unwanted": "bash tools/quality/check-unwanted-files.sh",
        "check": "pnpm typecheck && pnpm lint && pnpm stylelint && pnpm test && pnpm build",
        "dev": "vite",
        "format": "prettier --write resources/js resources/css tests/e2e eslint.config.js lefthook.yml package.json playwright.config.ts pnpm-workspace.yaml prettier.config.js stylelint.config.js tsconfig.e2e.json vite.config.js",
        "format:check": "prettier --check resources/js resources/css tests/e2e eslint.config.js lefthook.yml package.json playwright.config.ts pnpm-workspace.yaml prettier.config.js stylelint.config.js tsconfig.e2e.json vite.config.js",
        "lint": "eslint resources/js tests/e2e playwright.config.ts --max-warnings=0",
        "stylelint": "stylelint resources/css/**/*.css",
        "test": "vitest run resources/js --passWithNoTests",
        "test:e2e": "playwright test",
        "typecheck": "vue-tsc --noEmit && tsc --noEmit --project tsconfig.e2e.json"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.1.1",
        "concurrently": "^9.0.1",
        "eslint": "^10.7.0",
        "eslint-plugin-tailwindcss": "^4.2.0",
        "eslint-plugin-vue": "^10.9.2",
        "laravel-vite-plugin": "^3.1",
        "lefthook": "^2.1.10",
        "prettier": "^3.9.5",
        "stylelint": "^17.14.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.7"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@tabler/icons-vue": "^3.44.0",
        "@tanstack/vue-table": "^8.21.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "playwright": "^1.61.1",
        "vue": "^3.5.39"
    },
    "browserslist": [
        "last 2 Chrome major versions",
        "last 2 Edge major versions",
        "last 2 Firefox major versions",
        "not dead"
    ]
}
