# Non-secret production Compose contract. Copy outside the repository or pass
# with --env-file. Secret values live in owner-only files referenced below.
ATLAS_RELEASE_VERSION=0.1.0-smoke
ATLAS_RELEASE_ID=phase28-smoke
ATLAS_RELEASE_DEPLOYED_AT=
ATLAS_RELEASE_DEPLOYED_BY=
ATLAS_RELEASE_SOURCE=
APP_URL=http://localhost:8080
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
ATLAS_HTTP_BIND=127.0.0.1
ATLAS_HTTP_PORT=8080
REVERB_APP_ID=atlas-production
REVERB_APP_KEY=replace-with-public-reverb-key
REVERB_ALLOWED_ORIGINS=atlas.example.invalid
REVERB_CLIENT_HOST=atlas.example.invalid
REVERB_CLIENT_PORT=443
REVERB_CLIENT_SCHEME=https
ATLAS_PDF_RENDER_TIMEOUT_SECONDS=120

DB_DATABASE=atlas
DB_USERNAME=atlas
DB_SSLMODE=prefer

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME=Atlas

SENTRY_RELEASE=

ATLAS_FILES_DISK=atlas_files_s3
ATLAS_FILES_S3_DEFAULT_REGION=eu-central-1
ATLAS_FILES_S3_BUCKET=atlas-production
ATLAS_FILES_S3_URL=
ATLAS_FILES_S3_ENDPOINT=
ATLAS_FILES_S3_USE_PATH_STYLE_ENDPOINT=false
ATLAS_FILES_CLAMAV_HOST=clamav
ATLAS_FILES_CLAMAV_PORT=3310

ATLAS_SECRET_APP_KEY_FILE=./secrets/app_key.txt
ATLAS_SECRET_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
ATLAS_SECRET_REDIS_PASSWORD_FILE=./secrets/redis_password.txt
ATLAS_SECRET_MEILISEARCH_KEY_FILE=./secrets/meilisearch_master_key.txt
ATLAS_SECRET_MAIL_PASSWORD_FILE=./secrets/mail_password.txt
ATLAS_SECRET_SENTRY_LARAVEL_DSN_FILE=./secrets/sentry_laravel_dsn.txt
ATLAS_SECRET_FILES_S3_ACCESS_KEY_ID_FILE=./secrets/files_s3_access_key_id.txt
ATLAS_SECRET_FILES_S3_SECRET_ACCESS_KEY_FILE=./secrets/files_s3_secret_access_key.txt
ATLAS_SECRET_REVERB_APP_SECRET_FILE=./secrets/reverb_app_secret.txt
