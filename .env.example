APP_NAME=Atlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Warsaw
ATLAS_DEFAULT_CURRENCY=PLN
ATLAS_RELEASE_VERSION=0.1.0-dev
ATLAS_RELEASE_ID=local
ATLAS_TAILADMIN_PRO_LICENSE_STATE=not_confirmed
ATLAS_TAILADMIN_PRO_LICENSE_CONFIRMED_AT=
ATLAS_TAILADMIN_PRO_LICENSE_CONFIRMED_BY=
ATLAS_TAILADMIN_PRO_REDISTRIBUTION_CONFIRMED=false
ATLAS_RATE_LIMIT_AUTH_LOGIN_MAX_ATTEMPTS=5
ATLAS_RATE_LIMIT_AUTH_LOGIN_DECAY_SECONDS=60
ATLAS_RATE_LIMIT_AUTH_PASSWORD_RESET_MAX_ATTEMPTS=3
ATLAS_RATE_LIMIT_AUTH_PASSWORD_RESET_DECAY_SECONDS=3600
ATLAS_RATE_LIMIT_AUTH_MFA_MAX_ATTEMPTS=5
ATLAS_RATE_LIMIT_AUTH_MFA_DECAY_SECONDS=300
ATLAS_RATE_LIMIT_API_DEFAULT_MAX_ATTEMPTS=120
ATLAS_RATE_LIMIT_API_DEFAULT_DECAY_SECONDS=60
ATLAS_RATE_LIMIT_API_SENSITIVE_MAX_ATTEMPTS=30
ATLAS_RATE_LIMIT_API_SENSITIVE_DECAY_SECONDS=60
ATLAS_RATE_LIMIT_EXPORTS_CREATE_MAX_ATTEMPTS=10
ATLAS_RATE_LIMIT_EXPORTS_CREATE_DECAY_SECONDS=3600
ATLAS_RATE_LIMIT_IMPORTS_CREATE_MAX_ATTEMPTS=10
ATLAS_RATE_LIMIT_IMPORTS_CREATE_DECAY_SECONDS=3600
ATLAS_RATE_LIMIT_ADMIN_HIGH_RISK_MAX_ATTEMPTS=5
ATLAS_RATE_LIMIT_ADMIN_HIGH_RISK_DECAY_SECONDS=900
ATLAS_LOGIN_LOCK_MAX_FAILED_ATTEMPTS=10
ATLAS_LOGIN_LOCK_FIRST_SECONDS=900
ATLAS_LOGIN_LOCK_SECOND_SECONDS=1800
ATLAS_LOGIN_LOCK_THIRD_SECONDS=3600
ATLAS_SESSION_MAX_LIFETIME_MINUTES=720
ATLAS_MFA_REQUIRED_GLOBAL=false
ATLAS_MFA_REQUIRED_USERS=
ATLAS_MFA_REQUIRED_TEAMS=
ATLAS_MFA_REQUIRED_PERMISSIONS=
ATLAS_MFA_REQUIRED_OPERATIONS=
ATLAS_WEBAUTHN_RP_ID=localhost
ATLAS_WEBAUTHN_RP_NAME=Atlas
ATLAS_WEBAUTHN_TIMEOUT_MS=60000
PRODUCTION_DEPLOYED=false

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

COMPOSE_PROJECT_NAME=atlas
DOCKER_GID=998

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=atlas
DB_USERNAME=atlas
DB_PASSWORD=atlas_dev_password
DB_SSLMODE=prefer
DB_SEARCH_PATH=public,core_identity,core_teams,core_authorization,core_audit,core_settings,core_notifications,shared

CACHE_STORE=redis
CACHE_PREFIX=atlas_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=atlas_dev_meili_master_key
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=atlas_
SCOUT_QUEUE=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"

PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=atlas_dev_pgadmin_password

HORIZON_NAME=Atlas
HORIZON_PATH=horizon

TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
TELESCOPE_DB_CONNECTION=pgsql
DEBUGBAR_ENABLED=true

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

VITE_APP_NAME="${APP_NAME}"
