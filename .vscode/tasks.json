{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Atlas: Lint all Markdown",
            "type": "shell",
            "command": "pnpm lint:markdown",
            "group": "test",
            "problemMatcher": {
                "owner": "markdownlint",
                "severity": "error",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+)(?::(\\d+))?\\s+error\\s+(MD\\d+)/(\\S+)\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 6
                }
            }
        }
    ]
}
