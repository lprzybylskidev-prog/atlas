{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lprzybylskidev-prog/atlas",
    "type": "project",
    "description": "Atlas debt collection system.",
    "keywords": [
        "atlas",
        "debt-collection",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "guzzlehttp/guzzle": "^7.15.1",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/fortify": "^1.36",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.47",
        "laravel/pulse": "^1.7",
        "laravel/scout": "^11.3",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.8.3",
        "meilisearch/meilisearch-php": "^1.16",
        "phpoffice/phpspreadsheet": "^5.9",
        "sentry/sentry-laravel": "^4.26",
        "spatie/laravel-permission": "^8.3",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.4",
        "larastan/larastan": "^3.10",
        "laravel-lang/lang": "^15.32",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#86efac\" \"php artisan serve\" \"php artisan horizon\" \"php artisan schedule:work\" \"php artisan pail --timeout=0\" \"pnpm dev\" --names=server,horizon,scheduler,logs,vite --kill-others"
        ],
        "demo:reset": [
            "@php artisan demo:reset"
        ],
        "test:prepare": [
            "bash tools/testing/ensure-test-databases.sh phpunit"
        ],
        "test": [
            "@test:prepare",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "format": [
            "vendor/bin/pint",
            "pnpm format"
        ],
        "lint": [
            "vendor/bin/pint --test",
            "pnpm lint",
            "pnpm stylelint",
            "pnpm lint:markdown"
        ],
        "analyse": [
            "bash tools/quality/run-phpstan.sh --verify-coverage",
            "bash tools/quality/run-phpstan.sh"
        ],
        "runtime:check": [
            "bash tools/quality/check-runtime-contract.sh"
        ],
        "runtime:smoke": [
            "Composer\\Config::disableProcessTimeout",
            "bash tools/runtime/smoke-production.sh"
        ],
        "check:foundation": [
            "Composer\\Config::disableProcessTimeout",
            "@check",
            "pnpm test:e2e",
            "@runtime:smoke"
        ],
        "test:unit": [
            "@php artisan test --testsuite=Unit"
        ],
        "test:integration": [
            "@test:prepare",
            "@php artisan test --testsuite=Integration"
        ],
        "test:feature": [
            "@test:prepare",
            "@php artisan test --testsuite=Feature"
        ],
        "check": [
            "vendor/bin/pint --test",
            "pnpm format:check",
            "pnpm lint",
            "pnpm stylelint",
            "pnpm lint:markdown",
            "pnpm check:secrets",
            "pnpm check:unwanted",
            "bash tools/quality/check-env-example.sh",
            "bash tools/quality/check-playwright-version.sh",
            "@runtime:check",
            "@analyse",
            "@test",
            "pnpm typecheck",
            "pnpm test",
            "pnpm build"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
